NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=synthdetect
DB_USER=synthdetect
DB_PASSWORD=synthdetect_dev_pass

# JWT
JWT_SECRET=change_me_in_production_use_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=24h

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGIN=http://localhost:5173

# === SMTP (для email-верифікації і скидання паролю) ===
# Brevo: smtp-relay.brevo.com, port 587, SMTP keys на https://app.brevo.com/settings/keys/smtp
APP_NAME=SynthDetect
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=твій_brevo_login@smtp-brevo.com
SMTP_PASS=твій_brevo_smtp_key
SMTP_FROM=SynthDetect <noreply@yourdomain.com>

# Frontend URL — використовується в листах для побудови verification/reset посилань
FRONTEND_URL=http://localhost:5173
