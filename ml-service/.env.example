# Path to trained model weights (.pth)
MODEL_PATH=models/efficientnet_b0_synthdetect.pth
MODEL_VERSION=efficientnet_b0_v1.0

# Device: auto (auto-detect CUDA), cuda, or cpu
DEVICE=auto

# Server
HOST=0.0.0.0
PORT=8000

# Limits
MAX_FILE_SIZE_MB=10

# CORS — який сервіс може звертатись до ML-сервісу
CORS_ORIGINS=["http://localhost:3000"]
